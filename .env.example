# Copy to .env and fill in. Never commit or share the real file.
# deploy_secrets.sh pushes every non-empty line to Fly as a secret.

# First Management login (user name: management). Used only the first time the server starts.
INIT_ADMIN_PASSWORD=change-this-long-password

# Email (any SMTP service: Microsoft 365, Google Workspace, SendGrid, Mailgun...)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=change-me
SMTP_FROM=FenOps <notifications@example.com>

# WhatsApp option A: Meta WhatsApp Cloud API
WA_TOKEN=
WA_PHONE_ID=
# Optional: approved message template with one body variable. Needed to message people who have not written to you in the last 24 hours.
WA_TEMPLATE=
WA_TEMPLATE_LANG=en

# WhatsApp option B: Twilio (leave A empty)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WA_FROM=

# AI guide (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
